{
  "name": "sea",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "admin:build": "pnpm --filter admin build",
    "admin:check": "pnpm --filter admin check",
    "admin:dev": "pnpm --filter admin dev",
    "infra:config": "docker compose -f infra/docker-compose.yml config --quiet",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "unity:scene": "unity run apps/game-unity -- -executeMethod Sea.Editor.SeaSceneBuilder.CreateMainScene",
    "unity:test": "unity test apps/game-unity --mode EditMode --output apps/game-unity/Build/test-results.xml",
    "unity:test:runtime": "./scripts/test-unity-runtime.sh",
    "unity:build:webgl": "unity build apps/game-unity --target WebGL --execute-method Sea.Editor.SeaBuild.PerformWebGLBuild --output-path apps/game-unity/Build/WebGL --no-tail",
    "unity:build:macos": "unity build apps/game-unity --target StandaloneOSX --execute-method Sea.Editor.SeaBuild.PerformMacOSBuild --output-path apps/game-unity/Build/Sea.app --no-tail",
    "unity:source-check": "./scripts/check-unity-source.sh",
    "unity:verify": "./scripts/verify-unity.sh",
    "server:build": "./scripts/spacetime.sh build --module-path server/spacetimedb/spacetimedb",
    "server:generate:csharp": "./scripts/spacetime.sh generate --lang csharp --module-path server/spacetimedb/spacetimedb --out-dir apps/game-unity/Assets/Generated/SpacetimeDB",
    "server:generate:typescript": "./scripts/spacetime.sh generate --lang typescript --module-path server/spacetimedb/spacetimedb --out-dir packages/contracts/src/generated",
    "server:publish": "./scripts/spacetime.sh publish sea-local --server http://host.docker.internal:3000 --anonymous --yes --module-path server/spacetimedb/spacetimedb",
    "server:reset": "./scripts/reset-spacetime.sh",
    "server:test": "./scripts/dotnet.sh test server/spacetimedb/tests/Sea.Server.Tests.csproj",
    "check": "pnpm infra:config && pnpm admin:check && pnpm --filter @sea/contracts check",
    "verify": "pnpm check && pnpm server:build && pnpm server:test && pnpm unity:verify"
  }
}
