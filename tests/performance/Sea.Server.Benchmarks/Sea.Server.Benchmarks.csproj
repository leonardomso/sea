<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);$(SeaLegacyDomainWarnings)</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../server/spacetimedb/spacetimedb/Domain/*.cs" Link="Domain/%(Filename)%(Extension)" />
    <Compile Include="../../../server/spacetimedb/spacetimedb/CombatRules.cs" Link="CombatRules.cs" />
    <Compile Include="../../../server/spacetimedb/spacetimedb/TacticalRules.cs" Link="TacticalRules.cs" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
