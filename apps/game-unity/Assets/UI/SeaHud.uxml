<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="sea-hud" class="sea-hud">
        <ui:VisualElement class="top-watch chart-surface">
            <ui:VisualElement class="resource-cluster">
                <ui:VisualElement class="resource-chip">
                    <ui:Label text="G" class="resource-icon gold-resource" />
                    <ui:Label name="gold-label" text="0" class="resource-value" />
                </ui:VisualElement>
                <ui:VisualElement class="resource-chip">
                    <ui:Label text="◆" class="resource-icon diamond-resource" />
                    <ui:Label name="diamond-label" text="0" class="resource-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="header-tools">
                <ui:Button name="recenter-button" text="◎" tooltip="Center on ship (Home)" class="header-tool" />
                <ui:Button name="navigator-button" text="N" tooltip="Coordinate navigator" class="header-tool" />
                <ui:Button text="□" tooltip="Quests" class="header-tool" />
                <ui:Button text="□" tooltip="Inventory" class="header-tool" />
                <ui:Button text="□" tooltip="Ship" class="header-tool" />
                <ui:Button name="menu-button" text="☰" tooltip="Chart menu" class="header-tool" />
            </ui:VisualElement>

            <ui:VisualElement class="header-status">
                <ui:VisualElement class="connection-line">
                    <ui:VisualElement name="connection-beacon" class="connection-beacon" />
                    <ui:Label name="connection-status" text="CONNECTING…" class="micro-label" />
                </ui:VisualElement>
                <ui:Label name="navigation-readout" text="—  •  000°  •  0.0 KN" class="navigation-readout" />
                <ui:VisualElement name="wind-dial" class="wind-dial">
                    <ui:Label name="wind-arrow" text="↑" class="wind-arrow" />
                    <ui:Label name="wind-text" text="—" class="micro-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="top-coordinate-ruler" class="coordinate-ruler top-coordinate-ruler">
            <ui:Label name="top-coordinate-0" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-1" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-2" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-3" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-4" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-5" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-6" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-7" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-8" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-9" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-10" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-11" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-12" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-13" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-14" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-15" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-16" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-17" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-18" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-19" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-20" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-21" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-22" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-23" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-24" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-25" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-26" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-27" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-28" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-29" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-30" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-31" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-32" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-33" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-34" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-35" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-36" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-37" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-38" text="" class="coordinate-mark" />
            <ui:Label name="top-coordinate-39" text="" class="coordinate-mark" />
        </ui:VisualElement>

        <ui:VisualElement name="left-coordinate-ruler" class="coordinate-ruler left-coordinate-ruler">
            <ui:Label name="left-coordinate-0" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-1" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-2" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-3" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-4" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-5" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-6" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-7" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-8" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-9" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-10" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-11" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-12" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-13" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-14" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-15" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-16" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-17" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-18" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-19" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-20" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-21" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-22" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-23" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-24" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-25" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-26" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-27" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-28" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-29" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-30" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-31" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-32" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-33" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-34" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-35" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-36" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-37" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-38" text="" class="coordinate-mark" />
            <ui:Label name="left-coordinate-39" text="" class="coordinate-mark" />
        </ui:VisualElement>

        <ui:VisualElement name="mini-map-frame" class="mini-map-frame">
            <ui:Label text="STARTER COVE // LOCAL CHART" class="micro-label centered mini-map-title" />
        </ui:VisualElement>

        <ui:VisualElement name="target-frame" class="target-frame chart-surface hidden">
            <ui:VisualElement class="target-core">
                <ui:VisualElement class="target-heading-line">
                    <ui:Label text="◁ 100°" class="arc-mark" />
                    <ui:VisualElement class="target-reticle">
                        <ui:Label text="TARGET" class="eyebrow centered" />
                        <ui:Label name="target-name" text="NO TARGET" class="target-name" />
                        <ui:Label name="target-range" text="— NM" class="micro-label centered" />
                    </ui:VisualElement>
                    <ui:Label text="100° ▷" class="arc-mark" />
                </ui:VisualElement>
                <ui:VisualElement class="target-bars">
                    <ui:VisualElement class="instrument-row">
                        <ui:Label text="HULL" class="instrument-label" />
                        <ui:ProgressBar name="target-hull" low-value="0" high-value="1" class="instrument-bar hull-bar" />
                        <ui:Label name="target-hull-text" text="—" class="instrument-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="instrument-row">
                        <ui:Label text="ARMOUR" class="instrument-label" />
                        <ui:Label name="target-armor-text" text="—" class="instrument-value" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="fire-control" class="broadside-side fire-control">
                <ui:Label text="Q / SPACE" class="key-cap" />
                <ui:Label text="FIRE" class="broadside-name" />
                <ui:ProgressBar name="reload-gauge" low-value="0" high-value="1" value="1" class="reload-gauge" />
                <ui:Label name="reload-text" text="READY" class="readiness" />
                <ui:Label name="magazine-text" text="—" class="readiness" />
                <ui:VisualElement name="magazine-dots" class="magazine-dots">
                    <ui:VisualElement name="magazine-dot-0" class="magazine-dot" />
                    <ui:VisualElement name="magazine-dot-1" class="magazine-dot" />
                    <ui:VisualElement name="magazine-dot-2" class="magazine-dot" />
                    <ui:VisualElement name="magazine-dot-3" class="magazine-dot" />
                    <ui:VisualElement name="magazine-dot-4" class="magazine-dot" />
                    <ui:VisualElement name="magazine-dot-5" class="magazine-dot" />
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement class="bottom-deck">
            <ui:VisualElement class="player-ledger chart-surface">
                <ui:VisualElement class="ledger-heading">
                    <ui:Label text="MAP RANK" class="micro-label" />
                    <ui:Label name="map-rank-label" text="1" class="instrument-value" />
                    <ui:Label name="ship-loadout" text="—" class="data-label bronze-text" />
                </ui:VisualElement>
                <ui:VisualElement class="meter-heading">
                    <ui:Label text="HULL INTEGRITY" class="micro-label" />
                    <ui:Label name="hull-text" text="—" class="instrument-value" />
                </ui:VisualElement>
                <ui:ProgressBar name="player-hull" low-value="0" high-value="1" class="player-meter hull-bar" />
                <ui:VisualElement class="ledger-heading">
                    <ui:Label text="COMBAT POWER" class="micro-label" />
                    <ui:Label name="combat-power-label" text="—" class="instrument-value" />
                </ui:VisualElement>
                <ui:Label name="last-action" text="Click water to set course." class="captain-log" />
            </ui:VisualElement>

            <ui:VisualElement class="gunnery-deck chart-surface">
                <ui:VisualElement class="rail-heading">
                    <ui:Label text="GUNNERY DECK" class="eyebrow" />
                    <ui:Label name="volley-text" text="—" class="micro-label" />
                    <ui:Label name="ammo-count" text="ROUND • 0" class="data-label bronze-text" />
                </ui:VisualElement>
                <ui:VisualElement name="ammo-rail" class="command-rail">
                    <ui:Label text="SHOT" class="rail-label" />
                    <ui:Button name="ammo-round" text="1" tooltip="Round shot" class="command-slot selected" />
                    <ui:Button name="ammo-chain" text="2" tooltip="Chain shot" class="command-slot" />
                    <ui:Button name="ammo-grapeshot" text="3" tooltip="Grapeshot" class="command-slot" />
                    <ui:Button name="ammo-incendiary" text="4" tooltip="Incendiary shot" class="command-slot" />
                </ui:VisualElement>
                <ui:VisualElement name="ability-rail" class="command-rail ability-rail">
                    <ui:Button name="repair" text="R" tooltip="Repair" class="command-slot ability-slot" />
                    <ui:Button name="repair-kit" text="K" tooltip="Repair kit" class="command-slot ability-slot" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="ship-orders chart-surface">
                <ui:Label text="SHIP CONDITION" class="eyebrow" />
                <ui:VisualElement name="status-strip" class="status-strip">
                    <ui:Label name="status-text" text="CLEAR" class="status-clear" />
                </ui:VisualElement>
                <ui:Label name="channel-label" text="NO ACTIVE ORDER" class="micro-label" />
                <ui:ProgressBar name="channel-progress" low-value="0" high-value="1" class="channel-progress" />
                <ui:VisualElement class="order-shortcuts">
                    <ui:Label text="TAB  CYCLE TARGET" class="micro-label" />
                    <ui:Label text="T  CLEAR TARGET" class="micro-label" />
                    <ui:Label text="SPACE  RECENTER" class="micro-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="wreck-prompt" class="modal-scrim hidden">
            <ui:VisualElement class="wreck-dialog chart-surface">
                <ui:Label text="YOUR SHIP WAS SUNK" class="dialog-title" />
                <ui:Label name="wreck-text" text="START AGAIN AT PORT LOWELL." class="micro-label" />
                <ui:VisualElement class="dialog-actions">
                    <ui:Button name="respawn-button" text="START AGAIN AT PORT LOWELL" class="primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="crossing-prompt" class="modal-scrim hidden">
            <ui:VisualElement class="wreck-dialog chart-surface">
                <ui:Label text="THE CHART ENDS HERE" class="dialog-title" />
                <ui:Label name="crossing-text" text="SAIL ON TO THE NEXT CHART?" class="micro-label" />
                <ui:VisualElement class="dialog-actions">
                    <ui:Button name="crossing-button" text="SAIL ON" class="primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="coordinate-navigator" class="modal-scrim hidden">
            <ui:VisualElement class="coordinate-dialog chart-surface">
                <ui:Label text="SET CHART COURSE" class="dialog-title" />
                <ui:Label text="Y: AA–CZ  •  X: 0–60  •  EXAMPLE AX 59" class="micro-label" />
                <ui:TextField name="coordinate-input" value="AX 59" max-length="8" class="chart-input" />
                <ui:Label name="coordinate-error" text="" class="error-text" />
                <ui:VisualElement class="dialog-actions">
                    <ui:Button name="coordinate-submit" text="SET COURSE" class="primary-button" />
                    <ui:Button name="coordinate-cancel" text="CANCEL" class="chart-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="chart-menu" class="modal-scrim hidden">
            <ui:VisualElement class="chart-menu chart-surface">
                <ui:VisualElement class="menu-heading">
                    <ui:VisualElement>
                        <ui:Label text="CAPTAIN'S CHART" class="dialog-title" />
                        <ui:Label text="WORLD CONTINUES WHILE THIS CHART IS OPEN" class="micro-label" />
                    </ui:VisualElement>
                    <ui:Button name="menu-close" text="ESC  RETURN" class="chart-button" />
                </ui:VisualElement>
                <ui:VisualElement class="menu-body">
                    <ui:VisualElement class="menu-navigation">
                        <ui:Button name="controls-tab" text="CONTROLS" class="menu-tab selected" />
                        <ui:Button name="connection-tab" text="CONNECTION" class="menu-tab" />
                        <ui:Button name="resume-button" text="RETURN TO CHART" class="primary-button resume-button" />
                    </ui:VisualElement>
                    <ui:ScrollView name="rebind-list" class="rebind-list" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
