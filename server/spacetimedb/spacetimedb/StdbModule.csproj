<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Remove this debt baseline as Phases 9-12 split and harden the existing runtime. -->
    <!-- Spacetime schema contracts are grouped by table family and are not native interop types. -->
    <NoWarn>$(NoWarn);MA0008;MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.Runtime" Version="2.8.3" />
  </ItemGroup>
</Project>
