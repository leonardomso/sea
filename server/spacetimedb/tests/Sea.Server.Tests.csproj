<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Remove this debt baseline as Phases 9-12 split and harden the linked domain rules. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);$(SeaLegacyDomainWarnings)</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../spacetimedb/Rules.cs" Link="Rules.cs" />
    <Compile Include="../spacetimedb/SailingRules.cs" Link="SailingRules.cs" />
    <Compile Include="../spacetimedb/CombatRules.cs" Link="CombatRules.cs" />
    <Compile Include="../spacetimedb/TacticalRules.cs" Link="TacticalRules.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
